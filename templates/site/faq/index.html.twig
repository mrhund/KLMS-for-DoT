{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - FAQ{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">
                Häufig gestellte Fragen
            </h1>

            <!-- Search -->
            <div class="card mb-4">
                <div class="row">
                    <div class="col mb-3 mb-md-0">
                        <form action="{{ path('faq') }}" method="get">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                </div>
                                <input type="text" name="search" class="form-control" placeholder="FAQ suchen" value="{{ searchTerm }}">
                                <div class="input-group-append ml-2">
                                    <button class="btn btn-outline-primary" type="submit">Suchen</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- FAQ List -->
            {% if faqs %}
                <div class="faq-list">
                    {% for faq in faqs %}
                        <div class="faq-item mb-3">
                            <div class="card">
                                <div class="card-header faq-question" data-faq-id="{{ faq.id }}" style="cursor: pointer;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <i class="fas fa-question-circle me-2 text-primary"></i>
                                            {{ faq.question }}
                                        </h5>
                                        <i class="fas fa-chevron-down faq-toggle-icon"></i>
                                    </div>
                                </div>
                                <div class="card-body faq-answer" id="answer-{{ faq.id }}" style="display: none;">
                                    {{ faq.answer|raw }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="row">
                    <div class="col mb-3">
                        <div role="alert">
                            <h4 class="alert-heading">Kein Ergebnis gefunden!</h4>
                            {% if searchTerm %}
                                <p>Es konnte keine FAQ mit dem Suchbegriff <strong>{{ searchTerm }}</strong> gefunden werden!</p>
                                <p class="text-muted">
                                    Versuchen Sie einen anderen Suchbegriff oder 
                                    <a href="{{ path('faq') }}">zeigen Sie alle FAQs an</a>.
                                </p>
                            {% else %}
                                <p>Noch keine FAQs vorhanden.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if faqs %}
<style>
.faq-question:hover {
    border: 1px solid #df1238;
}

.faq-toggle-icon {
    transition: transform 0.3s ease;
}

.faq-toggle-icon.rotated {
    transform: rotate(180deg);
}

.faq-answer {
    border-top: 1px solid #dee2e6;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // FAQ Toggle Functionality
    document.querySelectorAll('.faq-question').forEach(function(question) {
        question.addEventListener('click', function() {
            const faqId = this.getAttribute('data-faq-id');
            const answer = document.getElementById('answer-' + faqId);
            const icon = this.querySelector('.faq-toggle-icon');
            
            if (answer.style.display === 'none' || answer.style.display === '') {
                // Show answer with slide down effect
                answer.style.display = 'block';
                answer.style.opacity = '0';
                answer.style.transform = 'translateY(-10px)';
                
                setTimeout(function() {
                    answer.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                    answer.style.opacity = '1';
                    answer.style.transform = 'translateY(0)';
                }, 10);
                
                icon.classList.add('rotated');
                
                // Update URL hash
                history.pushState(null, null, '#' + faqId);
            } else {
                // Hide answer with slide up effect
                answer.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                answer.style.opacity = '0';
                answer.style.transform = 'translateY(-10px)';
                
                setTimeout(function() {
                    answer.style.display = 'none';
                }, 300);
                
                icon.classList.remove('rotated');
                
                // Remove URL hash
                history.pushState(null, null, window.location.pathname + window.location.search);
            }
        });
    });
    
    // Auto-expand FAQ if URL contains hash
    if (window.location.hash) {
        const faqId = window.location.hash.substring(1);
        const question = document.querySelector('[data-faq-id="' + faqId + '"]');
        if (question) {
            question.click();
        }
    }
});
</script>
{% endif %}
{% endblock %}