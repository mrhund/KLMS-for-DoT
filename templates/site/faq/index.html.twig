{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - FAQ{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">
                Häufig gestellte Fragen
            </h1>

            <!-- Search -->
            <div class="card mb-4">
                <div class="row">
                    <div class="col mb-3 mb-md-0">
                        <form action="{{ path('faq') }}" method="get">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                </div>
                                <input type="text" name="search" class="form-control" placeholder="FAQ suchen" value="{{ searchTerm }}">
                                <div class="input-group-append ml-2">
                                    <button class="btn btn-outline-primary" type="submit">Suchen</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {% if searchTerm %}
                <div class="row">
                    <div class="col mb-3">
                        <div role="alert">
                            <h4 class="alert-heading">{{ faqs|length }} Ergebnis(se) gefunden!</h4>
                            <p>Suchergebnisse für "<strong>{{ searchTerm }}</strong>"</p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- FAQ Accordion -->
            {% if faqs %}
                <div class="accordion" id="faqAccordion">
                    {% for faq in faqs %}
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading{{ faq.id }}">
                                <button class="accordion-button collapsed" 
                                        type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#collapse{{ faq.id }}" 
                                        aria-expanded="false" 
                                        aria-controls="collapse{{ faq.id }}">
                                    <i class="fas fa-question-circle me-2 text-primary"></i>
                                    {{ faq.question }}
                                </button>
                            </h2>
                            <div id="collapse{{ faq.id }}" 
                                 class="accordion-collapse collapse" 
                                 aria-labelledby="heading{{ faq.id }}" 
                                 data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    {{ faq.answer|raw }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="row">
                    <div class="col mb-3">
                        <div role="alert">
                            <h4 class="alert-heading">Kein Ergebnis gefunden!</h4>
                            {% if searchTerm %}
                                <p>Es konnte keine FAQ mit dem Suchbegriff <strong>{{ searchTerm }}</strong> gefunden werden!</p>
                                <p class="text-muted">
                                    Versuchen Sie einen anderen Suchbegriff oder 
                                    <a href="{{ path('faq') }}">zeigen Sie alle FAQs an</a>.
                                </p>
                            {% else %}
                                <p>Noch keine FAQs vorhanden.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if faqs %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-expand FAQ if URL contains hash
    if (window.location.hash) {
        const faqId = window.location.hash.substring(1);
        const element = document.getElementById('collapse' + faqId);
        if (element) {
            const accordion = new bootstrap.Collapse(element, { show: true });
        }
    }
    
    // Update URL when FAQ is opened
    document.querySelectorAll('.accordion-button').forEach(button => {
        button.addEventListener('click', function() {
            const target = this.getAttribute('data-bs-target');
            const faqId = target.replace('#collapse', '');
            if (!this.classList.contains('collapsed')) {
                history.pushState(null, null, '#' + faqId);
            } else {
                history.pushState(null, null, window.location.pathname + window.location.search);
            }
        });
    });
});
</script>
{% endif %}
{% endblock %}