{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - Profil bearbeiten{% endblock %}

{% block main %}
    {% set user = form.vars.data %}
    <div class="container">
        {% embed "site/components/cards/skeletons/cardProfile.html.twig"  with { cardImg: user | user_image, 'cardSymbol': 'fas fas fa-user-circle fa-9x'} %}
            {% block cardBody %}
                <h1 class="h3 card-title mb-4">Profil bearbeiten</h1>
                {{ form_start(form) }}
                <div class="float-right">
                    <a class="btn btn-outline-primary" href="{{ path('user_profile_edit_pw') }}"><i class="fas fa-user-edit"></i> Passwort ändern</a>
                </div>
                {% if form.image is defined %}
                    {% set currentImage = '' %}
                    {% if form.image.vars.data is not null %}
                        {% set currentImage = vich_uploader_asset(form.image.vars.data, 'imageFile') %}
                    {% endif %}
                    {% if currentImage is empty %}
                        {% set fallbackImage = user | user_image %}
                        {% set currentImage = fallbackImage is not empty ? fallbackImage : '' %}
                    {% endif %}
                    {% set hasImage = currentImage is not empty %}
                    <div class="mb-4" data-profile-image-field>
                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center">
                            <div class="text-center mr-md-3 mb-3 mb-md-0">
                                <img id="profile-image-preview"
                                     data-initial-src="{{ hasImage ? currentImage : '' }}"
                                     data-has-image="{{ hasImage ? '1' : '0' }}"
                                     class="rounded-circle border"
                                     style="width: 160px; height: 160px; object-fit: cover;{{ hasImage ? '' : ' display:none;' }}"
                                     alt="Profilbild Vorschau">
                                <div id="profile-image-placeholder"
                                     class="rounded-circle border d-flex align-items-center justify-content-center"
                                     style="width: 160px; height: 160px; {{ hasImage ? 'display:none;' : '' }}">
                                    <i class="fas fa-user fa-3x text-muted"></i>
                                </div>
                            </div>
                            <div>
                                <label class="d-block font-weight-bold">{{ form_label(form.image.imageFile.file) }}</label>
                                <button type="button" class="btn btn-outline-primary mb-2 js-profile-image-select">
                                    <i class="fas fa-image"></i>
                                    Neues Bild auswählen
                                </button>
                                <button type="button"
                                        class="btn btn-outline-danger mb-2 js-profile-image-remove"
                                        {% if not hasImage %}style="display:none;"{% endif %}>
                                    <i class="fas fa-trash-alt"></i>
                                    Bild entfernen
                                </button>
                            </div>
                        </div>

                        {{ form_widget(form.image.imageFile.file, {'attr': {'class': 'd-none js-profile-image-input', 'accept': 'image/*'}}) }}
                        {% if form.image.imageFile.delete is defined %}
                            {{ form_widget(form.image.imageFile.delete, {'attr': {'class': 'd-none js-profile-image-delete'}}) }}
                        {% endif %}
                        {{ form_errors(form.image.imageFile.file) }}
                    </div>
                {% endif %}
                <h2 class="h4 pt-3">Persönliche Informationen</h2>
                {{ form_row(form.nickname, {'input_group_prepend' : '<i class="fas fa-headset"></i>'}) }}
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.firstname, {'input_group_prepend' : '<i class="fas fa-signature"></i>'}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.surname, {'input_group_prepend' : '<i class="fas fa-signature"></i>'}) }}
                    </div>
                </div>
                {{ form_row(form.email, {'input_group_prepend' : '<i class="far fa-envelope"></i>'}) }}
                {{ form_row(form.birthdate, {'input_group_prepend' : '<i class="fas fa-birthday-cake"></i>'}) }}
                {{ form_row(form.gender, {'input_group_prepend' : '<i class="fas fa-venus-mars"></i>'}) }}

                {% if user.personalDataConfirmed %}
                    <span class="text-muted">Persönliche Daten wurden verifiziert und können nicht geändert werden.</span>
                {% elseif user.personalDataLocked %}
                    <span class="text-muted">Persönliche Daten können nicht geändert werden.</span>
                {% endif %}

                <h2 class="h4 pt-3">Eventinfos</h2>
                {{ form_row(form.infoMails) }}

                <h2 class="h4 pt-3">Adresse</h2>
                {{ form_row(form.street, {'input_group_prepend' : '<i class="fas fa-road"></i>'}) }}
                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.postcode, {'input_group_prepend' : '<i class="fas fa-map-marked-alt"></i>'}) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(form.city, {'input_group_prepend' : '<i class="fas fa-city"></i>'}) }}
                    </div>
                </div>
                {{ form_row(form.country, {'input_group_prepend' : '<i class="fas fa-globe-europe"></i>'}) }}

                <h2 class="h4 pt-3">Allgemeines</h2>
                {{ form_row(form.statements, {'input_group_prepend' : '<i class="far fa-comment-dots"></i>'}) }}
                {{ form_row(form.phone, {'input_group_prepend' : '<i class="fas fa-mobile-alt"></i>'}) }}
                {{ form_row(form.steamAccount, {'input_group_prepend' : '<i class="fab fa-discord"></i>'}) }}
                {{ form_row(form.website, {'input_group_prepend' : '<i class="fas fa-globe"></i>'}) }}
                {{ form_row(form.hardware, {'input_group_prepend' : '<i class="fas fa-desktop"></i>'}) }}
                <hr>
                <div class="float-right pb-2 pt-2">
                    <a class="btn btn-secondary" href="{{ path('user_profile') }}">Abbrechen</a>
                    <button type="submit" id="user_save" class="btn-primary btn">Speichern</button>
                </div>
                {{ form_end(form) }}
            {% endblock %}
        {% endembed  %}
    </div>
{% endblock %}

{% if form.image is defined %}
<div class="modal fade" id="profileImageCropModal" tabindex="-1" role="dialog" aria-labelledby="profileImageCropModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content bg-dark text-light">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="profileImageCropModalLabel"><i class="fas fa-crop"></i> Bild zuschneiden</h5>
                <button type="button" class="close text-light" data-dismiss="modal" aria-label="Schließen">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="bg-dark p-2 rounded">
                    <img id="profile-image-crop" class="img-fluid" alt="Profilbild zuschneiden">
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" id="profileImageCropCancel" data-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-primary" id="profileImageCropSave"><i class="fas fa-check"></i> Zuschnitt übernehmen</button>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.querySelector('[data-profile-image-field]');
            if (!container) {
                return;
            }

            const fileInput = container.querySelector('.js-profile-image-input');
            const selectButton = container.querySelector('.js-profile-image-select');
            const removeButton = container.querySelector('.js-profile-image-remove');
            const deleteField = container.querySelector('.js-profile-image-delete');
            const previewImage = container.querySelector('#profile-image-preview');
            const placeholder = container.querySelector('#profile-image-placeholder');
            const modalElement = document.getElementById('profileImageCropModal');
            const cropperImage = modalElement ? modalElement.querySelector('#profile-image-crop') : null;
            const cropSave = document.getElementById('profileImageCropSave');
            const cropCancel = document.getElementById('profileImageCropCancel');
            const modalCloseButton = modalElement ? modalElement.querySelector('.close') : null;

            if (!fileInput || !previewImage || !placeholder) {
                return;
            }

            let cropper = null;
            let generatedObjectUrl = null;
            let bootstrapModal = null;
            let pendingDataUrl = null;
            let cropInProgress = false;
            let cropConfirmed = false;

            const setDeleteField = (state) => {
                if (!deleteField) {
                    return;
                }
                if (deleteField.type === 'checkbox') {
                    deleteField.checked = state;
                } else {
                    deleteField.value = state ? '1' : '';
                }
            };

            const revokeGeneratedUrl = () => {
                if (generatedObjectUrl) {
                    URL.revokeObjectURL(generatedObjectUrl);
                    generatedObjectUrl = null;
                }
            };

            const updatePreview = (src, markAsInitial = false, isGenerated = false) => {
                if (isGenerated) {
                    revokeGeneratedUrl();
                    generatedObjectUrl = src;
                } else if (!src) {
                    revokeGeneratedUrl();
                }

                if (src) {
                    previewImage.src = src;
                    previewImage.style.display = 'block';
                    placeholder.style.display = 'none';
                    if (removeButton) {
                        removeButton.style.display = '';
                    }
                } else {
                    previewImage.removeAttribute('src');
                    previewImage.style.display = 'none';
                    placeholder.style.display = '';
                    if (removeButton) {
                        removeButton.style.display = 'none';
                    }
                }

                if (markAsInitial) {
                    previewImage.dataset.initialSrc = src || '';
                    previewImage.dataset.hasImage = src ? '1' : '0';
                }
            };

            const initBootstrapModal = () => {
                if (!modalElement || bootstrapModal || !window.bootstrap || !window.bootstrap.Modal) {
                    return;
                }
                bootstrapModal = new window.bootstrap.Modal(modalElement, { backdrop: 'static' });
            };

            const showModal = () => {
                if (!modalElement) {
                    return;
                }

                initBootstrapModal();

                if (bootstrapModal) {
                    bootstrapModal.show();
                } else if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(modalElement).modal({ backdrop: 'static', keyboard: false, show: true });
                } else {
                    modalElement.classList.add('show');
                    modalElement.style.display = 'block';
                    modalElement.removeAttribute('aria-hidden');
                    modalElement.setAttribute('aria-modal', 'true');
                    document.body.classList.add('modal-open');
                    document.body.style.overflow = 'hidden';
                    initModalCropper();
                }
            };

            const hideModal = () => {
                if (!modalElement) {
                    return;
                }

                if (bootstrapModal) {
                    bootstrapModal.hide();
                } else if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(modalElement).modal('hide');
                } else {
                    modalElement.classList.remove('show');
                    modalElement.style.display = 'none';
                    modalElement.setAttribute('aria-hidden', 'true');
                    modalElement.removeAttribute('aria-modal');
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    handleModalHidden();
                }
            };

            const initModalCropper = () => {
                if (!pendingDataUrl || !cropperImage) {
                    return;
                }

                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }

                cropperImage.src = pendingDataUrl;
                cropper = new Cropper(cropperImage, {
                    aspectRatio: 1,
                    viewMode: 1,
                    autoCropArea: 1,
                    movable: true,
                    zoomable: true,
                    rotatable: false,
                    scalable: false,
                });
            };

            const teardownModalCropper = () => {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
                if (cropperImage) {
                    cropperImage.removeAttribute('src');
                }
            };

            const handleModalHidden = () => {
                teardownModalCropper();
                if (cropInProgress && !cropConfirmed) {
                    fileInput.value = '';
                    const restored = previewImage.dataset.initialSrc || '';
                    updatePreview(restored, false);
                }
                cropInProgress = false;
                cropConfirmed = false;
                pendingDataUrl = null;
            };

            const initialSrc = previewImage.dataset.initialSrc || '';
            if (previewImage.dataset.hasImage === '1' && initialSrc) {
                updatePreview(initialSrc, false);
            } else {
                updatePreview('', false);
            }

            if (modalElement) {
                modalElement.addEventListener('shown.bs.modal', initModalCropper);
                modalElement.addEventListener('hidden.bs.modal', handleModalHidden);
            }

            if (modalCloseButton) {
                modalCloseButton.addEventListener('click', () => {
                    if (!bootstrapModal && !(window.jQuery && typeof window.jQuery.fn.modal === 'function')) {
                        hideModal();
                    }
                });
            }

            if (cropCancel) {
                cropCancel.addEventListener('click', () => {
                    if (!bootstrapModal && !(window.jQuery && typeof window.jQuery.fn.modal === 'function')) {
                        hideModal();
                    }
                });
            }

            if (selectButton) {
                selectButton.addEventListener('click', () => fileInput.click());
            }

            if (removeButton) {
                removeButton.addEventListener('click', () => {
                    fileInput.value = '';
                    setDeleteField(true);
                    updatePreview('', true);
                    if (cropInProgress) {
                        hideModal();
                    }
                });
            }

            if (cropSave) {
                cropSave.addEventListener('click', () => {
                    if (!cropper) {
                        return;
                    }

                    const canvas = cropper.getCroppedCanvas({
                        width: 600,
                        height: 600,
                        imageSmoothingQuality: 'high',
                    });

                    if (!canvas) {
                        return;
                    }

                    setDeleteField(false);

                    canvas.toBlob((blob) => {
                        if (!blob) {
                            return;
                        }

                        const originalFile = fileInput.files[0];
                        const fileName = originalFile ? originalFile.name : 'profilbild.jpg';
                        const croppedFile = new File([blob], fileName, { type: blob.type, lastModified: Date.now() });
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(croppedFile);
                        fileInput.files = dataTransfer.files;

                        const objectUrl = URL.createObjectURL(croppedFile);
                        updatePreview(objectUrl, true, true);
                        cropConfirmed = true;
                        cropInProgress = false;
                        hideModal();
                    }, 'image/jpeg');
                });
            }

            fileInput.addEventListener('change', (event) => {
                const file = event.target.files[0];
                if (!file) {
                    return;
                }

                setDeleteField(false);
                cropInProgress = false;
                cropConfirmed = false;
                pendingDataUrl = null;

                const reader = new FileReader();
                reader.onload = (ev) => {
                    const result = ev.target ? ev.target.result : null;
                    if (!result) {
                        return;
                    }

                    if (typeof Cropper === 'undefined' || !modalElement) {
                        updatePreview(result, true);
                        return;
                    }

                    pendingDataUrl = result;
                    cropInProgress = true;
                    showModal();
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
{% endblock %}