{% extends 'site/siteBase.html.twig' %}

{% block title %}Galerie - {{ parent() }}{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">
                Galerie
            </h1>
            <p>Taucht ein in die Highlights vergangener Events! Hier findet ihr eine kleine Auswahl an Bildern, die die Atmosphäre, die Begeisterung und die besten Momente der DoT-LANs einfangen. Lasst euch inspirieren und freut euch auf das nächste Event!</p>
            
            {% if photosByEvent is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Noch keine Bilder in der Galerie vorhanden.
                </div>
            {% else %}
                {# Event Navigation #}
                <div class="mb-4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="btn-group" role="group" aria-label="Event Navigation">
                                <button type="button" class="btn btn-outline-primary active" onclick="showAllEvents()">
                                    Alle Events
                                </button>
                                {% for event in events %}
                                    <button type="button" class="btn btn-outline-primary" onclick="showEvent('{{ event }}')">
                                        {{ event|replace({'-': ' '})|title }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Images by Event #}
                {% for event, photos in photosByEvent %}
                    <div class="event-section" data-event="{{ event }}">
                        <h2 class="h3 mb-4">
                            <i class="fas fa-calendar-alt me-2"></i>
                            {{ event|replace({'-': ' '})|title }}
                            <small class="text-muted">({{ photos|length }} Bilder)</small>
                        </h2>
                        
                        <div class="row g-3 mb-5">
                            {% for photo in photos %}
                                <div class="col-6 col-md-4 col-lg-3 mb-4">
                                    <div class="card border-0">
                                        <a href="{{ photo.getImagePath() }}" 
                                           class="glightbox" 
                                           data-gallery="{{ event }}"
                                           data-title="{{ photo.title ? photo.title : (event|replace({'-': ' '})|title ~ ' - Bild ' ~ loop.index) }}"
                                           data-description="{{ photo.description ? photo.description : 'Event: ' ~ (event|replace({'-': ' '})|title) }}"
                                           title="{{ photo.title ?? (event|replace({'-': ' '})|title ~ ' - Bild ' ~ loop.index) }}">
                                            <img src="{{ photo.getImagePath()|imagine_filter('gallery_thumb') }}"
                                                 alt="{{ photo.title ?? 'Bild' }}"
                                                 class="card-img-top"
                                                 loading="lazy"
                                                 style="height: 200px; object-fit: cover;">
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {# GLightbox CSS and JS #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    
    {# Custom GLightbox Styles #}
    <style>
        /* Grundlegendes Lightbox-Styling */
        .glightbox-container {
            background: rgba(0, 0, 0, 0.9);
        }
        
        /* Bild-Styling im Lightbox */
        .gslide-image img {
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }
        
        /* Titel und Beschreibung */
        .gslide-title {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-align: center;
        }
        
        .gslide-desc {
            color: #e9ecef;
            font-size: 1rem;
            line-height: 1.5;
            text-align: center;
        }
        
        .gslide-description {
            background: rgba(0, 0, 0, 0.7);
            border-radius: 10px;
            padding: 15px;
            margin-top: 15px;
        }
        
        /* Navigation Buttons */
        .gbtn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .gbtn:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        /* Hover-Effekt für Grid-Bilder */
        .card img {
            transition: transform 0.3s ease;
        }
        
        .card:hover img {
            transform: scale(1.05);
        }
        
        /* Mobile Optimierungen */
        @media (max-width: 768px) {
            .gslide-title {
                font-size: 1.2rem;
            }
            
            .gslide-desc {
                font-size: 0.9rem;
            }
        }
    </style>
    
    <script>
        // Initialize GLightbox with simplified configuration
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true,
            closeButton: true,
            keyboardNavigation: true,
            plyr: {
                config: {
                    ratio: '16:9',
                    youtube: {
                        noCookie: true,
                        rel: 0,
                        showinfo: 0,
                        iv_load_policy: 3
                    },
                    vimeo: {
                        byline: false,
                        portrait: false,
                        title: false,
                        speed: true,
                        transparent: false
                    }
                }
            },
            openEffect: 'zoomIn',
            closeEffect: 'zoomOut',
            slideEffect: 'slide',
            moreText: 'Mehr anzeigen',
            moreLength: 60,
            closeBtnInside: false
        });

        // Event filtering
        function showAllEvents() {
            document.querySelectorAll('.event-section').forEach(section => {
                section.style.display = 'block';
            });
            setActiveButton('Alle Events');
        }

        function showEvent(eventName) {
            document.querySelectorAll('.event-section').forEach(section => {
                if (section.dataset.event === eventName) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
            setActiveButton(eventName);
        }

        function setActiveButton(activeEvent) {
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.textContent.trim() === 'Alle Events' && activeEvent === 'Alle Events') {
                    btn.classList.add('active');
                } else if (btn.textContent.trim().toLowerCase() === activeEvent.replace(/-/g, ' ').toLowerCase()) {
                    btn.classList.add('active');
                }
            });
        }
    </script>
{% endblock %}