{% extends 'site/siteBase.html.twig' %}

{% block title %}Galerie - {{ parent() }}{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">
                Galerie
            </h1>
            <p>Taucht ein in die Highlights vergangener Events! Hier findet ihr eine kleine Auswahl an Bildern, die die Atmosphäre, die Begeisterung und die besten Momente der DoT-LANs einfangen. Lasst euch inspirieren und freut euch auf das nächste Event!</p>
            
            {% if photosByEvent is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Noch keine Bilder in der Galerie vorhanden.
                </div>
            {% else %}
                {# Event Navigation #}
                <div class="mb-4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="btn-group" role="group" aria-label="Event Navigation">
                                <button type="button" class="btn btn-outline-primary active" onclick="showAllEvents()">
                                    Alle Events
                                </button>
                                {% for event in events %}
                                    <button type="button" class="btn btn-outline-primary" onclick="showEvent('{{ event }}')">
                                        {{ event|replace({'-': ' '})|title }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Images by Event #}
                {% for event, photos in photosByEvent %}
                    <div class="event-section" data-event="{{ event }}">
                        <h2 class="h3 mb-4">
                            <i class="fas fa-calendar-alt me-2"></i>
                            {{ event|replace({'-': ' '})|title }}
                            <small class="text-muted">({{ photos|length }} Bilder)</small>
                        </h2>
                        
                        <div class="row g-3 mb-5">
                            {% for photo in photos %}
                                <div class="col-6 col-md-4 col-lg-3 mb-4">
                                    <div class="card border-0">
                                        <a href="{{ photo.getImagePath() }}" 
                                           class="glightbox" 
                                           data-gallery="{{ event }}"
                                           data-glightbox="title: {{ photo.title ? photo.title|e('html_attr') : (event|replace({'-': ' '})|title ~ ' - Bild ' ~ loop.index) }}; description: {{ photo.description ? photo.description|e('html_attr') : 'Event: ' ~ (event|replace({'-': ' '})|title) }}"
                                           title="{{ photo.title ?? (event|replace({'-': ' '})|title ~ ' - Bild ' ~ loop.index) }}">
                                            <img src="{{ photo.getImagePath()|imagine_filter('gallery_thumb') }}"
                                                 alt="{{ photo.title ?? 'Bild' }}"
                                                 class="card-img-top"
                                                 loading="lazy"
                                                 style="height: 200px; object-fit: cover;">
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {# GLightbox CSS and JS #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    
    {# Custom GLightbox Styles #}
    <style>
        /* Custom GLightbox Styling */
        .glightbox-container {
            background: rgba(0, 0, 0, 0.95) !important;
        }
        
        /* Custom overlay */
        .goverlay {
            background: linear-gradient(45deg, rgba(0, 123, 255, 0.1), rgba(40, 167, 69, 0.1)) !important;
        }
        
        /* Image container styling */
        .gslide-image img {
            max-width: 90vw;
            max-height: 80vh;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }
        
        /* Title and description styling */
        .gslide-title {
            color: #fff !important;
            font-size: 1.5rem !important;
            font-weight: 600 !important;
            margin-bottom: 0.5rem !important;
            text-align: center;
        }
        
        .gslide-desc {
            color: #e9ecef !important;
            font-size: 1rem !important;
            line-height: 1.5;
            text-align: center;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .gslide-description {
            background: rgba(0, 0, 0, 0.7) !important;
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }
        
        /* Navigation buttons */
        .gbtn {
            color: #fff !important;
            background: rgba(255, 255, 255, 0.2) !important;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .gbtn:hover {
            background: rgba(255, 255, 255, 0.3) !important;
            transform: scale(1.1);
        }
        
        .gclose {
            top: 20px !important;
            right: 20px !important;
            width: 45px;
            height: 45px;
        }
        
        .gprev, .gnext {
            width: 50px;
            height: 50px;
            top: 50% !important;
        }
        
        .gprev {
            left: 20px !important;
        }
        
        .gnext {
            right: 20px !important;
        }
        
        /* Loading animation */
        .gloader {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 3px solid #007bff;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Mobile optimizations */
        @media (max-width: 768px) {
            .gslide-image img {
                max-width: 95vw;
                max-height: 70vh;
            }
            
            .gslide-title {
                font-size: 1.2rem !important;
            }
            
            .gslide-desc {
                font-size: 0.9rem !important;
            }
            
            .gbtn {
                width: 40px;
                height: 40px;
            }
            
            .gclose {
                width: 35px;
                height: 35px;
                top: 10px !important;
                right: 10px !important;
            }
        }
        
        /* Custom body class when lightbox is open */
        body.glightbox-open {
            overflow: hidden;
        }
        
        /* Zoom animation on image hover in grid */
        .card img {
            transition: transform 0.3s ease;
        }
        
        .card:hover img {
            transform: scale(1.05);
        }
    </style>
    
    <script>
        // Initialize GLightbox with custom configuration
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true,
            autoplayVideos: false,
            closeButton: true,
            touchFollowAxis: true,
            keyboardNavigation: true,
            
            // Custom slide configuration
            slideEffect: 'slide', // 'slide', 'fade', 'zoom'
            openEffect: 'zoomIn', // 'zoomIn', 'zoomOut', 'fadeIn', 'fadeInUp', 'none'
            closeEffect: 'zoomOut', // 'zoomOut', 'zoomIn', 'fadeOut', 'fadeOutUp', 'none'
            
            // Responsive breakpoints
            width: '90vw',
            height: '90vh',
            videosWidth: '960px',
            
            // Custom skin/theme
            skin: 'clean', // You can create custom skins
                   
            // Slide HTML template customization
            slideHTML: '<div class="gslide">' +
                          '<div class="gslide-inner-content">' +
                              '<div class="ginner-container">' +
                                  '<div class="gslide-media">' +
                                  '</div>' +
                                  '<div class="gslide-description">' +
                                      '<div class="gdesc-inner">' +
                                          '<h4 class="gslide-title"></h4>' +
                                          '<div class="gslide-desc"></div>' +
                                      '</div>' +
                                  '</div>' +
                              '</div>' +
                          '</div>' +
                      '</div>',
                      
            // Lightbox HTML structure
            lightboxHTML: '<div id="glightbox-body" class="glightbox-container" tabindex="-1" role="dialog" aria-hidden="false">' +
                             '<div class="gloader visible"></div>' +
                             '<div class="goverlay"></div>' +
                             '<div class="gcontainer">' +
                                 '<div id="glightbox-slider" class="gslider"></div>' +
                                 '<button class="gclose gbtn" aria-label="Close" data-taborder="3">{closeSVG}</button>' +
                                 '<button class="gprev gbtn" aria-label="Previous" data-taborder="2">{prevSVG}</button>' +
                                 '<button class="gnext gbtn" aria-label="Next" data-taborder="1">{nextSVG}</button>' +
                             '</div>' +
                         '</div>'
        });

        // Event filtering
        function showAllEvents() {
            document.querySelectorAll('.event-section').forEach(section => {
                section.style.display = 'block';
            });
            setActiveButton('Alle Events');
        }

        function showEvent(eventName) {
            document.querySelectorAll('.event-section').forEach(section => {
                if (section.dataset.event === eventName) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
            setActiveButton(eventName);
        }

        function setActiveButton(activeEvent) {
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.textContent.trim() === 'Alle Events' && activeEvent === 'Alle Events') {
                    btn.classList.add('active');
                } else if (btn.textContent.trim().toLowerCase() === activeEvent.replace(/-/g, ' ').toLowerCase()) {
                    btn.classList.add('active');
                }
            });
        }
    </script>
{% endblock %}