{% extends 'site/siteBase.html.twig' %}

{% block title %}Anmeldung{% endblock %}

{% block main %}
    {% embed "site/components/cards/skeletons/cardProfileRound.html.twig"  with {'cardSymbol': 'fas fa-sign-in-alt'} %}
        {% block cardBody %}
            <h1 class=" h3 card-title text-center">Anmeldung</h1>
            <p class="text-center">Die Anmeldung und Passwortverwaltung erfolgt sicher über Cognito.</p>
            <div class="text-center">
                <a class="btn btn-lg btn-primary" href="{{ path('app_login') }}">Erneut mit Cognito anmelden</a>
            </div>
        {% endblock %}

        {% block cardFooter %}
            Beim ersten Login wird die Vergabe eines neuen Passworts verlangt.
        {% endblock %}
    {% endembed  %} 
{% endblock %}
