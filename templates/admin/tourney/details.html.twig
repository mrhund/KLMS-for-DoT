{% extends 'admin/adminBase.html.twig' %}

{% block title %}Turnierdetails – {{ tourney.name }}{% endblock %}
{% block siteheading %}<i class="fa-solid fa-trophy"></i> Turniere{% endblock %}

{% block main %}
    {% from 'site/tourney/show.html.twig' import teamname, teamnameA, teamnameB %}
    {% set TourneyStage = enum('\\App\\Entity\\TourneyStage') %}
    {% set detailRedirectPath = path('admin_tourney_details', {'id': tourney.id}) %}

    {# Macros #}
    {% macro action_button(text, path, token, redirect, icon, color = 'danger') %}
        <form data-toggle="confirmModal" data-modal-title="Bestätigen" data-modal-text="Wirklich {{ text|lower }}?" method="post" action="{{ path }}" class="d-inline-block mr-2 mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
            {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}">{% endif %}
            <button type="submit" class="btn btn-sm btn-{{ color }}"><i class="fa-solid fa-{{ icon }}"></i> {{ text }}</button>
        </form>
    {% endmacro %}

    {% macro delete_button(team, token, redirect) %}
        <form data-toggle="confirmModal" data-modal-title="Bestätigen" data-modal-text="Wirklich abmelden?" method="post" action="{{ path('admin_tourney_remove_team', {'id': team.id}) }}" class="d-inline-block">
            <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
            {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}">{% endif %}
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
        </form>
    {% endmacro %}

    {% import _self as m %}

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body d-flex flex-wrap align-items-center">
                    <div>
                        <h1 class="h4 mb-1">{{ tourney.name }}</h1>
                        <p class="mb-0 text-muted">Token: {{ tourney.token }} • Reihenfolge: {{ tourney.order }}</p>
                    </div>
                    <div class="ml-auto d-flex flex-wrap align-items-center" style="gap: .5rem;">
                        <a href="{{ path('admin_tourney') }}" class="btn btn-outline-secondary btn-sm mb-2">
                            <i class="fa-solid fa-arrow-left"></i> Zurück zur Übersicht
                        </a>
                        {% if tourney.status == TourneyStage.Created %}
                            {{ m.action_button('Registrierung starten', path('admin_tourney_advance', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-right') }}
                        {% elseif tourney.status == TourneyStage.Registration %}
                            {{ m.action_button('Registrierung zurücksetzen', path('admin_tourney_back', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-left') }}
                            {{ m.action_button('Registrierung schließen', path('admin_tourney_advance', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-right') }}
                        {% elseif tourney.status == TourneyStage.Seeding %}
                            {{ m.action_button('Registrierung wiederöffnen', path('admin_tourney_back', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-left') }}
                            {{ m.action_button('Turnier starten', path('admin_tourney_advance', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-right') }}
                            <button type="button" class="btn btn-outline-dark text-nowrap btn-sm mb-2 mr-2"
                                    data-toggle="ajaxModal" href="{{ path('admin_tourney_seed', {'id': tourney.id}) }}">
                                <i class="fa-solid fa-circle-info"></i> Seed bearbeiten
                            </button>
                            {% if tourney.mode.hasTree %}
                                <a class="btn btn-outline-dark btn-sm mb-2 mr-2" href="{{ path('tourney_show', {'id': tourney.id}) }}" target="_blank">
                                    <i class="fa-solid fa-tree"></i> Baum anzeigen
                                </a>
                            {% endif %}
                        {% elseif tourney.status == TourneyStage.Running %}
                            {{ m.action_button('Turnier neustarten', path('admin_tourney_back', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-left') }}
                            {% if not tourney.mode.canHaveGames %}
                                <button type="button" class="btn btn-outline-dark text-nowrap btn-sm mb-2 mr-2"
                                        data-toggle="ajaxModal" href="{{ path('admin_tourney_result', {'id': tourney.id}) }}">
                                    <i class="fa-solid fa-trophy"></i> Ergebnis eintragen
                                </button>
                            {% endif %}
                            {{ m.action_button('Turnier beenden', path('admin_tourney_advance', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-right') }}
                            {% if tourney.mode.hasTree %}
                                <a class="btn btn-outline-dark btn-sm mb-2 mr-2" href="{{ path('tourney_show', {'id': tourney.id}) }}" target="_blank">
                                    <i class="fa-solid fa-tree"></i> Baum anzeigen
                                </a>
                            {% endif %}
                        {% elseif tourney.status == TourneyStage.Finished %}
                            {{ m.action_button('Turnier wiedereröffnen', path('admin_tourney_back', {'id': tourney.id}), csrf_token_advance, detailRedirectPath, 'arrow-circle-left') }}
                            {% if tourney.mode.hasTree %}
                                <a class="btn btn-outline-dark btn-sm mb-2 mr-2" href="{{ path('tourney_show', {'id': tourney.id}) }}" target="_blank">
                                    <i class="fa-solid fa-tree"></i> Baum anzeigen
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if not tourney.canHaveTeams %}
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center mb-0">Dieses Turnier hat noch keine Details.</div>
            </div>
        </div>
    {% else %}
        <div class="row">
            <div class="{% if tourney.canHaveGames %}col-lg-6{% else %}col-lg-12{% endif %} mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0"><i class="fa-solid fa-people-group"></i> Teams ({{ tourney.teams | length }} / {{ tourney.maxTeams | default('&infin;') | raw }})</h5>
                            {% if tourney.status.canRegister %}
                                <button type="button" class="btn btn-sm btn-success" data-toggle="ajaxModal" href="{{ path('admin_tourney_add_team', {'id': tourney.id, 'redirect': detailRedirectPath}) }}">
                                    <i class="fa-solid fa-plus"></i> Team hinzufügen
                                </button>
                            {% endif %}
                        </div>
                        <p class="text-muted mb-3" style="font-size: small;">
                            Registrierte User{% if not tourney.singlePlayer %} (bestätigt, <i class="italic">nicht bestätigt</i>){% endif %}.
                        </p>
                        <ul class="list-group mb-0">
                            {% for team in tourney.teams %}
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <b>{{ teamname(team) }}</b>
                                            {% if not tourney.singlePlayer %}
                                                <br>
                                                <span>{% for tm in team.members %}{% if not tm.accepted %}<i class="text-muted">{% endif %}{{ tm.gamer | username }}{% if not tm.accepted %}</i>{% endif %}{% if not loop.last %},  {% endif %}{% endfor %}</span>
                                            {% endif %}
                                        </div>
                                        {% if tourney.status.canRegister %}
                                            <div class="d-flex" style="gap: 0.5rem;">
                                                <button type="button" class="btn btn-outline-primary btn-sm" data-toggle="ajaxModal" href="{{ path('admin_tourney_edit_team', {'id': team.id, 'redirect': detailRedirectPath}) }}" title="Team bearbeiten">
                                                    <i class="fa-solid fa-pencil"></i>
                                                </button>
                                                {{ m.delete_button(team, csrf_token_modify, detailRedirectPath) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </li>
                            {% else %}
                                <li class="list-group-item text-center text-muted">Noch keine Teams vorhanden.</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            {% if tourney.canHaveGames %}
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5><i class="fa-solid fa-gamepad"></i> Games</h5>
                            <hr>
                            <h6>Ausstehende Spiele</h6>
                            <ul class="list-group mb-3">
                                {% for game in tourney.games | filter(game => game.pending) %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>{{ teamnameA(game) }} <span class="font-weight-bold">vs</span> {{ teamnameB(game) }}</div>
                                        <button type="button" class="btn btn-outline-dark text-nowrap btn-sm"
                                                data-toggle="ajaxModal" href="{{ path('admin_tourney_game_result', {'id' : game.id}) }}">
                                            <i class="fa-solid fa-pencil"></i>
                                        </button>
                                    </div>
                                {% else %}
                                    <li class="list-group-item text-muted">Keine ausstehenden Spiele vorhanden.</li>
                                {% endfor %}
                            </ul>

                            <h6>Abgeschlossene Spiele</h6>
                            <ul class="list-group mb-0">
                                {% for game in tourney.games | filter(game => game.done) %}
                                    <li class="list-group-item">
                                        <span>
                                            {% if game.hasWon(true) %}<b>{% endif %}{{ teamnameA(game) }}{% if game.hasWon(true) %}</b>{% endif %}
                                            vs
                                            {% if game.hasWon(false) %}<b>{% endif %}{{ teamnameB(game) }}{% if game.hasWon(false) %}</b>{% endif %}
                                            ({{ game.scoreA }} : {{ game.scoreB }})
                                        </span>
                                    </li>
                                {% else %}
                                    <li class="list-group-item text-muted">Noch keine Ergebnisse vorhanden.</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
