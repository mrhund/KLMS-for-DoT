{% embed "modules/modals/skeleton.html.twig"
    with {
    'id': 'seedModal',
    'title' : tourney.name ~ ' - Seed bearbeiten',
    'dialogClass' : 'modal-lg modal-dialog-scrollable'
} %}
    {% block modalContentPrepend %}
        {{ form_start(form) }}
    {% endblock %}

    {% block modalBody %}
        {% from 'site/tourney/show.html.twig' import teamname %}
        
        <div class="alert alert-info">
            <i class="fa-solid fa-info-circle"></i> 
            Ziehen Sie die Teams in die gewünschte Reihenfolge (Seed 1 = oben, höchster Seed = unten).
        </div>

        <div id="seedList" class="list-group">
            {% for team in teams %}
                <div class="list-group-item d-flex align-items-center" draggable="true" data-team-id="{{ team.id }}">
                    <span class="badge badge-primary mr-3">{{ loop.index }}</span>
                    <i class="fa-solid fa-grip-vertical mr-2 text-muted" style="cursor: grab;"></i>
                    <span class="flex-grow-1">{{ teamname(team) }}</span>
                    <input type="hidden" name="seed[]" value="{{ team.id }}">
                </div>
            {% endfor %}
        </div>

        <style>
            #seedList .list-group-item {
                cursor: move;
                transition: background-color 0.2s;
            }
            #seedList .list-group-item:hover {
                background-color: #f8f9fa;
            }
            #seedList .list-group-item.dragging {
                opacity: 0.5;
            }
            #seedList .list-group-item.drag-over {
                border-top: 3px solid #007bff;
            }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const seedList = document.getElementById('seedList');
                const items = seedList.querySelectorAll('.list-group-item');
                
                let draggedItem = null;

                items.forEach(item => {
                    item.addEventListener('dragstart', function(e) {
                        draggedItem = this;
                        this.classList.add('dragging');
                        e.dataTransfer.effectAllowed = 'move';
                    });

                    item.addEventListener('dragend', function() {
                        this.classList.remove('dragging');
                        items.forEach(i => i.classList.remove('drag-over'));
                        updateSeeds();
                    });

                    item.addEventListener('dragover', function(e) {
                        e.preventDefault();
                        e.dataTransfer.dropEffect = 'move';
                        
                        if (draggedItem !== this) {
                            this.classList.add('drag-over');
                        }
                    });

                    item.addEventListener('dragleave', function() {
                        this.classList.remove('drag-over');
                    });

                    item.addEventListener('drop', function(e) {
                        e.preventDefault();
                        if (draggedItem !== this) {
                            const allItems = [...seedList.querySelectorAll('.list-group-item')];
                            const draggedIndex = allItems.indexOf(draggedItem);
                            const targetIndex = allItems.indexOf(this);
                            
                            if (draggedIndex < targetIndex) {
                                this.parentNode.insertBefore(draggedItem, this.nextSibling);
                            } else {
                                this.parentNode.insertBefore(draggedItem, this);
                            }
                        }
                        this.classList.remove('drag-over');
                    });
                });

                function updateSeeds() {
                    const items = seedList.querySelectorAll('.list-group-item');
                    items.forEach((item, index) => {
                        const badge = item.querySelector('.badge');
                        badge.textContent = index + 1;
                    });
                }
            });
        </script>
    {% endblock %}

    {% block modalFooter %}
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Abbrechen</button>
        {{ form_row(form.submit) }}
    {% endblock %}

    {% block modalContentAppend %}
        {{ form_end(form) }}
    {% endblock %}
{% endembed %}
