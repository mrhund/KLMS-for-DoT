{% extends 'admin/adminBase.html.twig' %}

{% block title %}Polls - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-poll"></i> Umfragen{% endblock %}

{% block main %}
    <div class="row">
        <div class="col mb-4">
            <a role="button" class="btn btn-success" href="{{ path('admin_poll_create') }}">
                <i class="fas fa-plus"></i>
                Umfrage erstellen
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <table id="pollTable" class="table table-striped admin-data-table" data-order='[[1, "desc"]]'>
                    <thead>
                        <tr>
                            <th>Frage</th>
                            <th class="text-nowrap">Start</th>
                            <th class="text-nowrap">Ende</th>
                            <th class="text-nowrap">Status</th>
                            <th class="text-nowrap">Nur registriert</th>
                            <th class="text-nowrap w-1">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for poll in polls %}
                        {% set active = poll.isActive() %}
                        {% set ended = poll.hasEnded() %}
                        <tr>
                            <td>{{ poll.question }}</td>
                            <td>{{ poll.startAt ? poll.startAt|date('d.m.Y H:i') : '-' }}</td>
                            <td>{{ poll.endAt ? poll.endAt|date('d.m.Y H:i') : '-' }}</td>
                            <td>
                                {% if ended %}
                                    <span class="badge badge-secondary">Beendet</span>
                                {% elseif active %}
                                    <span class="badge badge-success">Aktiv</span>
                                {% else %}
                                    <span class="badge badge-info">Geplant</span>
                                {% endif %}
                            </td>
                            <td>{{ poll.onlyRegistered ? 'Ja' : 'Nein' }}</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_poll_options', {'id': poll.id}) }}">
                                    <i class="fas fa-list"></i>
                                    Optionen
                                </a>
                                <a class="btn btn-sm btn-outline-dark" href="{{ path('admin_poll_edit', {'id': poll.id}) }}">
                                    <i class="fas fa-edit"></i>
                                    Bearbeiten
                                </a>
                                <form method="post" action="{{ path('admin_poll_delete', {'id': poll.id}) }}" class="d-inline-block" data-toggle="confirmModal">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_poll_' ~ poll.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        <i class="fas fa-trash-alt"></i>
                                        Löschen
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">Noch keine Umfragen vorhanden.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
