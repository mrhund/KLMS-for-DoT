{% extends 'admin/adminBase.html.twig' %}

{% block title %}QR-Code Check-In{% endblock %}

{% block body %}
<div id="checkin-root" class="container py-3"
    data-show-url-template="{{ path('admin_payment_show_by_code', {'code': 'CODE'}) }}">
    <h1 class="h3">Quick Check-In</h1>
    <p class="text-muted">Scanne QR-Codes mit dem Ticketcode. Für mobile Geräte optimiert.</p>

    <div class="card mb-3">
        <div class="card-body text-center">
            <video id="qr-video" playsinline autoplay muted style="width:100%;max-height:60vh;object-fit:cover;border-radius:6px;background:#000"></video>
                <canvas id="qr-canvas" style="display:none"></canvas>
                <div class="mt-2 d-flex justify-content-center gap-2 align-items-center">
                    <label for="device-select" class="mb-0">Kamera:</label>
                    <select id="device-select" class="form-select form-select-sm" style="width:auto"></select>
                </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <meta name="csrf-token" content="{{ csrf_token('quick_checkin') }}">
    {{ encore_entry_script_tags('admin_checkin') }}
{% endblock %}
